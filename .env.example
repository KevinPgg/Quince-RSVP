# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clave secreta (Settings > API > service_role).
# NUNCA con prefijo NEXT_PUBLIC_. Solo se usa en el servidor.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Panel de administración ---
# Única llave del panel. Mínimo 16 caracteres aleatorios.
# Generar con: openssl rand -base64 24
ADMIN_PASSWORD=cambia-esto-por-algo-largo-y-aleatorio

# --- Sitio ---
# Solo se usa para los links que genera el script de carga masiva.
NEXT_PUBLIC_SITE_URL=https://quince-angeles.vercel.app
